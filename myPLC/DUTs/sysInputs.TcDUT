	iAlarmButton_ftrig : F_TRIG;
	iTestButton_rtrig	 : R_TRIG;
	
	iAlarmButton : BOOL;
	iTestbutton: BOOL;
	
	
	iHoldAlarm : BOOL;
	iHoldTest : BOOL;
	iHoldAlarm_HMI: BOOL;
	iHoldTest_HMI : BOOL;
	

	
	limitSwitchOpen_rtrig : F_TRIG;
	limitSwitchClose_rtrig : R_TRIG;
	
	ilimitSwitchOpen : BOOL;
	ilimitSwitchClose: BOOL;
	
