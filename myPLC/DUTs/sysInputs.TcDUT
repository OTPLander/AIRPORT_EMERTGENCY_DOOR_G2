    iAlarmButton_HMI     : BOOL;
    iTestButton_HMI      : BOOL;
	iSwitch              : BOOL;
	iAlarmButton_preFtrig: BOOL;
	iTestButton_preRtrig : BOOL;

	
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
